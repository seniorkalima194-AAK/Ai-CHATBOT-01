# Placeholder: example environment configuration for local development.
# --- LLM settings ---
# Ollama model name (must already be pulled via `ollama pull <name>`)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
# Generation randomness: 0.0 = deterministic, 1.0 = very random
OLLAMA_TEMPERATURE=0.2
# How long to wait for Ollama before giving up, in seconds
OLLAMA_TIMEOUT=120

# --- RAG / chunking settings ---
# Max tokens per document chunk
CHUNK_SIZE=400
# Token overlap between consecutive chunks
CHUNK_OVERLAP=50
# Number of chunks retrieved per student question
TOP_K=5

# --- Vector DB ---
# Local path where the vector store lives (Chroma persistent dir, etc.)
SIMILARITY_THRESHOLD=0.50

# --- CORS ---
# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

# --- Environment ---
# development | production
ENVIRONMENT=development

# --- Embeddings ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
